<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="q250_v3_opti">
    <static>false</static>
    
    <!-- ============================================================
         BASE LINK (Center of Gravity)
         실측값: 1.08kg (배터리+Jetson+카메라+프레임 포함)
         관성텐서: Ixx=0.008, Iyy=0.008, Izz=0.014 (kg·m²)
    ============================================================ -->
    <link name="base_link">
      <pose>0 0 0.05 0 0 0</pose>  <!-- 지면에서 5cm 높이 -->
      <inertial>
        <mass>1.08</mass>
        <inertia>
          <ixx>0.008</ixx> <ixy>0</ixy> <ixz>0</ixz>
          <iyy>0.008</iyy> <iyz>0</iyz>
          <izz>0.014</izz>
        </inertia>
        <pose>0 0 0 0 0 0</pose>
      </inertial>
      
      <collision name="base_collision">
        <geometry><box><size>0.3 0.3 0.1</size></box></geometry>
        <surface>
          <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
        </surface>
      </collision>
      
      <visual name="base_visual">
        <geometry><mesh><uri>model://q250_v3_opti/meshes/frame.stl</uri></mesh></geometry>
        <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
      </visual>
    </link>

    <!-- ============================================================
         MOTOR 1: Front Right (CW) - AUX1
         Position (FRD, COG 기준): X=+0.12, Y=-0.12, Z=-0.025
    ============================================================ -->
    <joint name="motor1_joint" type="revolute">
      <parent>base_link</parent>
      <child>motor1_link</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper></limit>
        <dynamics><damping>0.001</damping><friction>0.001</friction></dynamics>
      </axis>
      <pose>0.12 -0.12 -0.025 0 0 0</pose>
    </joint>
    <link name="motor1_link">
      <inertial>
        <mass>0.05</mass>
        <inertia><ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0002</izz></inertia>
        <pose>0 0 0 0 0 0</pose>
      </inertial>
      <collision name="motor1_collision">
        <geometry><cylinder><radius>0.025</radius><length>0.03</length></cylinder></geometry>
      </collision>
      <visual name="motor1_visual">
        <geometry><mesh><uri>model://q250_v3_opti/meshes/motor.stl</uri></mesh></geometry>
      </visual>
    </link>

    <!-- ============================================================
         MOTOR 2: Rear Right (CW) - AUX2
         Position: X=-0.12, Y=-0.12, Z=-0.025
    ============================================================ -->
    <joint name="motor2_joint" type="revolute">
      <parent>base_link</parent>
      <child>motor2_link</child>
      <axis><xyz>0 0 1</xyz></axis>
      <pose>-0.12 -0.12 -0.025 0 0 0</pose>
    </joint>
    <link name="motor2_link">
      <inertial><mass>0.05</mass><inertia><ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0002</izz></inertia></inertial>
      <collision><geometry><cylinder><radius>0.025</radius><length>0.03</length></cylinder></geometry></collision>
      <visual><geometry><mesh><uri>model://q250_v3_opti/meshes/motor.stl</uri></mesh></geometry></visual>
    </link>

    <!-- ============================================================
         MOTOR 3: Front Left (CCW) - AUX3
         Position: X=+0.12, Y=+0.12, Z=-0.025
    ============================================================ -->
    <joint name="motor3_joint" type="revolute">
      <parent>base_link</parent>
      <child>motor3_link</child>
      <axis><xyz>0 0 1</xyz></axis>
      <pose>0.12 0.12 -0.025 0 0 0</pose>
    </joint>
    <link name="motor3_link">
      <inertial><mass>0.05</mass><inertia><ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0002</izz></inertia></inertial>
      <collision><geometry><cylinder><radius>0.025</radius><length>0.03</length></cylinder></geometry></collision>
      <visual><geometry><mesh><uri>model://q250_v3_opti/meshes/motor.stl</uri></mesh></geometry></visual>
    </link>

    <!-- ============================================================
         MOTOR 4: Rear Left (CCW) - AUX4
         Position: X=-0.12, Y=+0.12, Z=-0.025
    ============================================================ -->
    <joint name="motor4_joint" type="revolute">
      <parent>base_link</parent>
      <child>motor4_link</child>
      <axis><xyz>0 0 1</xyz></axis>
      <pose>-0.12 0.12 -0.025 0 0 0</pose>
    </joint>
    <link name="motor4_link">
      <inertial><mass>0.05</mass><inertia><ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0002</izz></inertia></inertial>
      <collision><geometry><cylinder><radius>0.025</radius><length>0.03</length></cylinder></geometry></collision>
      <visual><geometry><mesh><uri>model://q250_v3_opti/meshes/motor.stl</uri></mesh></geometry></visual>
    </link>

    <!-- ============================================================
         PROPELLERS (Visual only - physics via motor plugin)
    ============================================================ -->
    <joint name="prop1_joint" type="fixed">
      <parent>motor1_link</parent>
      <child>prop1_link</child>
      <pose>0 0 0.015 0 0 0</pose>
    </joint>
    <link name="prop1_link">
      <visual><geometry><mesh><uri>model://q250_v3_opti/meshes/propeller.stl</uri></mesh></visual>
    </link>
    <!-- Prop 2 -->
    <joint name="prop2_joint" type="fixed"><parent>motor2_link</parent><child>prop2_link</child><pose>0 0 0.015 0 0 0</pose></joint>
    <link name="prop2_link"><visual><geometry><mesh><uri>model://q250_v3_opti/meshes/propeller.stl</uri></mesh></geometry></visual></link>
    <!-- Prop 3 -->
    <joint name="prop3_joint" type="fixed"><parent>motor3_link</parent><child>prop3_link</child><pose>0 0 0.015 0 0 0</pose></joint>
    <link name="prop3_link"><visual><geometry><mesh><uri>model://q250_v3_opti/meshes/propeller.stl</uri></mesh></geometry></visual></link>
    <!-- Prop 4 -->
    <joint name="prop4_joint" type="fixed"><parent>motor4_link</parent><child>prop4_link</child><pose>0 0 0.015 0 0 0</pose></joint>
    <link name="prop4_link"><visual><geometry><mesh><uri>model://q250_v3_opti/meshes/propeller.stl</uri></mesh></geometry></visual></link>

    <!-- ============================================================
         OPTICAL-FLOW + LiDAR MODULE (UART4, Downward facing)
         Position: Z = -0.04m (base_link 아래 4cm)
    ============================================================ -->
    <link name="of_lidar_link">
      <pose>0 0 -0.04 0 0 0</pose>
      <inertial>
        <mass>0.02</mass>
        <inertia><ixx>0.00001</ixx><iyy>0.00001</iyy><izz>0.00002</izz></inertia>
      </inertial>
    </link>
    <joint name="of_lidar_joint" type="fixed">
      <parent>base_link</parent>
      <child>of_lidar_link</child>
    </joint>

    <!-- ============================================================
         GPS MODULE (Optional, TELEM3 port)
         Position: Z = +0.05m (above base_link)
    ============================================================ -->
    <link name="gps_link">
      <pose>0 0 0.05 0 0 0</pose>
      <inertial><mass>0.03</mass><inertia><ixx>0.00001</ixx><iyy>0.00001</iyy><izz>0.00002</izz></inertia></inertial>
    </link>
    <joint name="gps_joint" type="fixed">
      <parent>base_link</parent>
      <child>gps_link</child>
    </joint>

    <!-- ============================================================
         CAMERA MODULE (Optional, Front-facing for VIO)
    ============================================================ -->
    <link name="camera_link">
      <pose>0.15 0 0 0 0 0</pose>  <!-- 전방 15cm -->
      <inertial><mass>0.015</mass><inertia><ixx>0.00001</ixx><iyy>0.00001</iyy><izz>0.00001</izz></inertia></inertial>
    </link>
    <joint name="camera_joint" type="fixed">
      <parent>base_link</parent>
      <child>camera_link</child>
    </joint>

    <!-- ============================================================
         MULTICOPTER MOTOR MODEL PLUGIN (PX4 Compatible)
         BrotherHobby 모터: KV=1000, 4S, R=0.05Ω, L=0.1mH
    ============================================================ -->
    <plugin name="multicopter_motor_model" filename="libMulticopterMotorModel.so">
      <rotorDragCoefficient>0.001</rotorDragCoefficient>
      <motorConstant>8.5e-06</motorConstant>      <!-- Thrust coefficient (N·s²/rad²) -->
      <momentConstant>0.016</momentConstant>      <!-- Torque coefficient (N·m·s²/rad²) -->
      <maxRotVelocity>1200</maxRotVelocity>       <!-- Max angular velocity (rad/s) -->
      <rotorDragCoefficient>0.001</rotorDragCoefficient>
      <motorNumber>4</motorNumber>
      <rotorDragCoefficient>0.001</rotorDragCoefficient>
      <motorConstantsFromKV>True</motorConstantsFromKV>
      <kv>1000</kv>                                <!-- Motor KV rating -->
      <cellCount>4</cellCount>                     <!-- 4S LiPo -->
      <motorResistance>0.05</motorResistance>      <!-- Phase resistance (Ohms) -->
      <motorInductance>0.0001</motorInductance>   <!-- Phase inductance (H) -->
    </plugin>

    <!-- ============================================================
         PX4 SITL INTERFACE PLUGIN
    ============================================================ -->
    <plugin name="px4_sitl" filename="libPx4SITLPlugin.so">
      <modelName>q250_v3_opti</modelName>
      <paramFile>model://q250_v3_opti/px4_params.txt</paramFile>
    </plugin>

    <!-- ============================================================
         SENSORS (Included in base_link via plugins)
    ============================================================ -->
    
    <!-- IMU Sensor (base_link에 내장) -->
    <plugin name="imu_plugin" filename="libImuPlugin.so" filename="libImuPlugin.so">
      <robotNamespace>/q250_v3_opti</robotNamespace>
      <topicName>/fmu/out/sensor_combined</topicName>
      <frameId>base_link</frameId>
      <update_rate>400</update_rate>
      <noise><stddev>0.001</stddev></noise>
      <rate_noise><stddev>0.0005</stddev></rate_noise>
      <accel_noise><stddev>0.01</stddev></accel_noise>
      <bias_noise><stddev>0.0001</stddev></bias_noise>
    </plugin>

    <!-- Optical-Flow Sensor (of_lidar_link에 장착) -->
    <plugin name="optical_flow_plugin" filename="libOpticalFlowPlugin.so">
      <robotNamespace>/q250_v3_opti</robotNamespace>
      <topicName>/fmu/out/optical_flow</topicName>
      <frameId>of_lidar_link</frameId>
      <update_rate>100</update_rate>
      <focal_length>1.0</focal_length>
      <image_width>64</image_width>
      <image_height>64</image_height>
      <min_distance>0.1</min_distance>
      <max_distance>10.0</max_distance>
      <noise><stddev>0.01</stddev></noise>
    </plugin>

    <!-- LiDAR Sensor (of_lidar_link에 장착, Downward) -->
    <plugin name="lidar_plugin" filename="libGazeboRosRaySensor.so">
      <robotNamespace>/q250_v3_opti</robotNamespace>
      <topicName>/fmu/out/distance_sensor</topicName>
      <frameId>of_lidar_link</frameId>
      <update_rate>100</update_rate>
      <ray>
        <scan>
          <horizontal><samples>1</samples><resolution>1</resolution><min_angle>0</min_angle><max_angle>0</max_angle></horizontal>
          <vertical><samples>1</samples><resolution>1</resolution><min_angle>0</min_angle><max_angle>0</max_angle></vertical>
        </scan>
        <range><min>0.02</min><max>11.0</max><resolution>0.01</range>
        <noise><type>gaussian</type><mean>0.0</mean><stddev>0.02</stddev></noise>
      </ray>
    </plugin>

    <!-- IMU Sensor (base_link) -->
    <plugin name="imu_sensor_plugin" filename="libImuPlugin.so">
      <robotNamespace>/q250_v3_opti</robotNamespace>
      <topicName>/fmu/out/sensor_combined</topicName>
      <frameId>base_link</frameId>
      <update_rate>400</update_rate>
      <noise><stddev>0.001</stddev></noise>
      <rate_noise><stddev>0.0005</stddev></rate_noise>
      <accel_noise><stddev>0.01</stddev></accel_noise>
      <bias_noise><stddev>0.0001</stddev></bias_noise>
    </plugin>

    <!-- GPS Sensor (Optional, gps_link) -->
    <plugin name="gps_plugin" filename="libGpsPlugin.so">
      <robotNamespace>/q250_v3_opti</robotNamespace>
      <topicName>/fmu/out/vehicle_gps_position</topicName>
      <frameId>gps_link</frameId>
      <update_rate>10</update_rate>
      <position_noise><stddev>0.5</stddev></position_noise>
      <velocity_noise><stddev>0.1</stddev></velocity_noise>
    </plugin>

    <!-- Camera Sensor (Optional, camera_link, Front-facing for VIO) -->
    <plugin name="camera_plugin" filename="libGazeboRosCamera.so">
      <robotNamespace>/q250_v3_opti</robotNamespace>
      <topicName>/fmu/out/camera/image_raw</topicName>
      <frameId>camera_link</frameId>
      <update_rate>30</update_rate>
      <width>640</width>
      <height>480</height>
      <format>R8G8B8</format>
      <hfov>1.396</hfov>  <!-- 80 degrees -->
    </plugin>

  </model>
</sdf>
