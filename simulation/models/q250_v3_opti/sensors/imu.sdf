<sensor name="imu" type="imu">
  <always_on>true</always_on>
  <update_rate>400</update_rate>
  <visualize>false</visualize>
  <imu>
    <noise><type>gaussian</type><mean>0.0</mean><stddev>0.001</stddev></noise>
    <rate_noise><type>gaussian</type><mean>0.0</mean><stddev>0.0005</stddev></rate_noise>
    <accel_noise><type>gaussian</type><mean>0.0</mean><stddev>0.01</stddev></accel_noise>
    <bias_noise><type>gaussian</type><mean>0.0</mean><stddev>0.0001</stddev></bias_noise>
  </imu>
  <plugin name="imu_plugin" filename="libImuPlugin.so">
    <robotNamespace>/q250_v3_opti</robotNamespace>
    <topicName>/fmu/out/sensor_combined</topicName>
    <frameId>base_link</frameId>
  </plugin>
</sensor>
