<sensor name="camera" type="camera">
  <always_on>true</always_on>
  <update_rate>30</update_rate>
  <visualize>false</visualize>
  <camera>
    <horizontal_fov>1.396</horizontal_fov>  <!-- 80 degrees -->
    <image_width>640</image_width>
    <image_height>480</image_height>
    <format>R8G8B8</format>
    <noise><type>gaussian</type><mean>0.0</mean><stddev>0.001</stddev></noise>
  </camera>
  <plugin name="camera_plugin" filename="libGazeboRosCamera.so">
    <robotNamespace>/q250_v3_opti</robotNamespace>
    <topicName>/fmu/out/camera/image_raw</topicName>
    <frameId>camera_link</frameId>
    <width>640</width>
    <height>480</height>
    <format>R8G8B8</format>
  </plugin>
</sensor>
