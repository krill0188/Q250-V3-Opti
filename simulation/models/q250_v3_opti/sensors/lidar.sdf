<sensor name="lidar" type="ray">
  <always_on>true</always_on>
  <update_rate>100</update_rate>
  <visualize>true</visualize>
  <ray>
    <scan>
      <horizontal><samples>1</samples><resolution>1</resolution><min_angle>0</min_angle><max_angle>0</max_angle></horizontal>
      <vertical><samples>1</samples><resolution>1</resolution><min_angle>0</min_angle><max_angle>0</max_angle></vertical>
    </scan>
    <range><min>0.02</min><max>11.0</max><resolution>0.01</range>
    <noise><type>gaussian</type><mean>0.0</mean><stddev>0.02</stddev></noise>
  </ray>
  <plugin name="lidar_plugin" filename="libGazeboRosRaySensor.so">
    <robotNamespace>/q250_v3_opti</robotNamespace>
    <topicName>/fmu/out/distance_sensor</topicName>
    <frameId>of_lidar_link</frameId>
  </plugin>
</sensor>
