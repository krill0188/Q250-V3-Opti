# Q250-V3-Opti Jetson Orin SSH Configuration
# Copy this file to ~/.config/q250/jetson.env and customize
# Then source it: source ~/.config/q250/jetson.env

# =============================================================================
# SSH Connection Settings
# =============================================================================
# Jetson Orin hostname or IP address
# Examples: jetson.local, 192.168.1.100, jetson-orin.local
export JETSON_HOST="jetson.local"

# SSH username on Jetson (default: jetson, or nvidia for older JetPack)
export JETSON_USER="jetson"

# SSH port (default: 22)
export JETSON_PORT="22"

# SSH private key path (use ed25519 for best security)
# Generate with: ssh-keygen -t ed25519 -f ~/.ssh/id_ed25519_q250
export JETSON_KEY="${HOME}/.ssh/id_ed25519_q250"

# =============================================================================
# Remote Paths (on Jetson)
# =============================================================================
# Project directory on Jetson
export JETSON_PROJECT_DIR="/home/${JETSON_USER}/Q250-V3-Opti"

# Calibration data directory on Jetson
export JETSON_CALIB_DIR="/home/${JETSON_USER}/data/drone_datasets/processed/drone_audio"

# Checkpoint directory on Jetson
export JETSON_CHECKPOINT_DIR="/home/${JETSON_USER}/checkpoints"

# =============================================================================
# Local Paths (on development machine)
# =============================================================================
# Local project root (auto-detected if not set)
# export LOCAL_PROJECT_DIR="${HOME}/projectm/Q250-V3-Opti"

# Local checkpoint directory
export LOCAL_CHECKPOINT_DIR="${HOME}/projectm/Q250-V3-Opti/checkpoints"

# =============================================================================
# Pipeline Configuration
# =============================================================================
# Calibration methods to run (entropy, percentile, or both)
export CALIB_METHODS="entropy,percentile"

# Calibration percentile for IInt8MinMaxCalibrator (default: 99.9)
export CALIB_PERCENTILE="99.9"

# Number of calibration batches (default: 32)
export CALIB_BATCHES="32"

# Calibration batch size (default: 32)
export CALIB_BATCH_SIZE="32"

# Benchmark iterations (default: 100)
export BENCHMARK_ITERATIONS="100"

# =============================================================================
# Deployment Options
# =============================================================================
# Skip deployment if files already on Jetson
export SKIP_DEPLOY="false"

# Dry run mode (show commands without executing)
export DRY_RUN="false"

# =============================================================================
# GitHub Actions Secrets (for CI/CD integration)
# =============================================================================
# These should be set as GitHub repository secrets:
# JETSON_HOST, JETSON_USER, JETSON_KEY (base64 encoded), JETSON_PORT
# JETSON_CALIB_DIR, JETSON_CHECKPOINT_DIR

# Example: echo -n "your-private-key" | base64 -w 0
# Then add as JETSON_KEY_BASE64 secret